# Tiger Cloud connection string (Console > service > Connect)
DATABASE_URL=postgresql://tsdbadmin:<PASSWORD>@<HOST>:<PORT>/tsdb?sslmode=require

# Twelve Data API key (https://twelvedata.com/account/api-keys)
TWELVEDATA_API_KEY=<YOUR_API_KEY>

# Optional
# SYMBOLS=BTC/USD,ETH/USD,MSFT,AAPL
# MAX_BATCH_SIZE=10
